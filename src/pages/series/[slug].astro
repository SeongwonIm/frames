---
import '../../styles/global.css';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import exifr from 'exifr';
import fs from 'node:fs';

export async function getStaticPaths() {
  const series = await getCollection('series');
  return series.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const photosWithExif = await Promise.all(
  entry.data.photos.map(async (photo) => {
    let exifLabel = '';
    try {
      const cleanPath = (photo.src as any).fsPath;
      if (cleanPath && fs.existsSync(cleanPath)) {
        const buffer = fs.readFileSync(cleanPath);
        const exif = await exifr.parse(buffer, ['FocalLength', 'FNumber', 'ExposureTime', 'ISO']);
        if (exif?.FocalLength) {
          const shutter =
            exif.ExposureTime < 1
              ? `1/${Math.round(1 / exif.ExposureTime)}s`
              : `${exif.ExposureTime}s`;
          exifLabel = `${Math.round(exif.FocalLength)}mm · f/${exif.FNumber} · ${shutter} · ISO ${exif.ISO}`;
        }
      }
    } catch {}
    return { ...photo, exifLabel };
  })
);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{entry.data.title}</title>
  </head>
  <body class="bg-neutral-50 text-neutral-900 antialiased">
    <main class="max-w-4xl mx-auto px-6 py-16">
      <a href="/frames/" class="text-xs font-mono text-neutral-400 hover:text-neutral-900">
        ← Back to Index
      </a>

      <header class="mt-8 mb-12">
        <h1 class="text-2xl font-medium tracking-tight">{entry.data.title}</h1>
        <p class="text-xs font-mono text-neutral-500 mt-2">
          {entry.data.date.toISOString().slice(0, 10)} · {entry.data.location} · {entry.data.camera}
        </p>
        <div class="mt-6 text-sm text-neutral-700 leading-relaxed max-w-2xl">
          <Content />
        </div>
      </header>

      <div class="space-y-16">
        {photosWithExif.map((photo) => (
          <figure>
            <Image
              src={photo.src}
              alt={photo.caption || entry.data.title}
              widths={[800, 1400, 2000]}
              class="w-full h-auto"
            />
            <figcaption class="mt-3 flex flex-wrap justify-between gap-2 text-xs text-neutral-500">
              <span>{photo.caption}</span>
              {photo.exifLabel && <span class="font-mono text-neutral-400">{photo.exifLabel}</span>}
            </figcaption>
          </figure>
        ))}
      </div>
    </main>
  </body>
</html>