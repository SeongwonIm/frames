---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const allSeries = (await getCollection('series')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Photography Journal</title>
  </head>
  <body class="bg-neutral-50 text-neutral-900 antialiased">
    <main class="max-w-5xl mx-auto px-6 py-16">
      <header class="mb-16">
        <h1 class="text-xl font-medium tracking-tight">Daily Clicks</h1>
        <p class="text-sm text-neutral-500 mt-1">Nikon D3400 · Archive</p>
      </header>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
        {allSeries.map((entry) => (
          <a href={`/frames/series/${entry.id}`} class="group block">
            <div class="overflow-hidden bg-neutral-200">
              <Image
                src={entry.data.cover}
                alt={entry.data.title}
                widths={[600, 1000]}
                class="w-full aspect-[3/2] object-cover transition-transform duration-500 group-hover:scale-[1.02]"
              />
            </div>
            <div class="mt-3 flex justify-between items-baseline">
              <h2 class="text-base font-medium">{entry.data.title}</h2>
              <span class="text-xs text-neutral-400 font-mono">
                {entry.data.date.toISOString().slice(0, 10)}
              </span>
            </div>
          </a>
        ))}
      </div>
    </main>
  </body>
</html>